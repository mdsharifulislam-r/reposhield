# RepoShield .gitignore

# Build outputs
dist/
build/

# Dependencies
node_modules/

# Test outputs
coverage/
*.lcov

# Scan reports (may contain redacted secrets — keep out of git)
reposhield-report.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo

# npm
.npm/

# Windows reserves this name. Git cannot hash a file called nul.
/nul

# Local command output dumped in the repo root
/*.txt
/*.log
/jest*.json
/jest*.cjs
/results*.json
/res-now.json
/summary.json
/jj.json
/analyze-*.cjs
/now-report.cjs
/run-tests.cjs
/sumarize.cjs
/tmp-show.cjs
/tscheck.cjs
