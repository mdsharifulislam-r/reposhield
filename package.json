{
  "name": "reposhield-scan",
  "version": "1.0.0",
  "description": "Advanced repository malware defense — layered static analysis, supply-chain protection, Git history scanning, and policy enforcement for Node.js projects.",
  "keywords": [
    "security",
    "malware",
    "supply-chain",
    "npm",
    "git",
    "static-analysis",
    "ast",
    "secrets",
    "ci",
    "audit"
  ],
  "author": "RepoShield Contributors",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "bin": {
    "reposhield-scan": "./dist/cjs/cli/index.js"
  },
  "files": [
    "dist/",
    "rules/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "node -e \"const fs=require('fs');const rm=(p)=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}};rm('dist');\"",
    "test": "node node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node node_modules/jest/bin/jest.js --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.7",
    "p-limit": "^3.1.0",
    "semver": "^7.6.0",
    "strip-json-comments": "^5.0.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^20.12.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.integration.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testTimeout": 30000
  }
}
